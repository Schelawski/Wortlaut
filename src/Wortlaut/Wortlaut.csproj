<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wortlaut</RootNamespace>
    <AssemblyName>Wortlaut</AssemblyName>

    <Product>Wortlaut</Product>
    <Description>Transcribes video and audio files with Faster-Whisper-XXL.</Description>
    <Version>1.0.0</Version>
    <!-- Shown in the file properties of Wortlaut.exe (Details tab) -->
    <Authors>A. Schelawski</Authors>
    <Copyright>© 2026 A. Schelawski – free software (GPL-3.0), official source: github.com/Schelawski/Wortlaut</Copyright>

    <!-- WinForms application defaults (consumed by ApplicationConfiguration.Initialize) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <!-- Build a single self-contained Wortlaut.exe with the .NET runtime embedded -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms does not support trimming -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- The UI is German and Russian: keep only those framework resources (English is built in) -->
    <SatelliteResourceLanguages>de;ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wortlaut.Tests" />
  </ItemGroup>

  <!-- Help texts, one Markdown file per UI language (see Core/Help/HelpDocument.cs).
       WithCulture=false: "help.ru.md" is not a satellite resource, both stay inside Wortlaut.exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Help\help.*.md" LogicalName="Wortlaut.Help.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

</Project>
